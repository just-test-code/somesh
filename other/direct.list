# 内容：直连内容
# Windows / macOS 常用远程控制与组网软件
# PROCESS-NAME 需要客户端支持进程匹配；域名规则用于补充服务连接。
# 自建服务的域名、虚拟网段请按实际配置另行添加。

# Tailscale（含 macOS App Store / 独立版网络扩展）
PROCESS-NAME,tailscale.exe
PROCESS-NAME,tailscaled.exe
PROCESS-NAME,tailscale-ipn.exe
PROCESS-NAME,Tailscale
PROCESS-NAME,tailscale
PROCESS-NAME,tailscaled
PROCESS-NAME,IPNExtension
PROCESS-NAME,io.tailscale.ipn.macsys.network-extension
PROCESS-NAME,io.tailscale.ipn.macos.network-extension
DOMAIN-SUFFIX,tailscale.com
DOMAIN-SUFFIX,tailscale.io
DOMAIN-SUFFIX,ts.net

